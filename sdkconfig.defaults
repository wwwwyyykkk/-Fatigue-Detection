CONFIG_IDF_TARGET="esp32s3"
# ⚠️ 主板是 S3N32R16 = 32MB flash(勿改回 8MB,会启动死循环)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 分区表：2.5MB app 空间（放得下 ESP-DL + 人脸检测模型）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-DL: 人脸检测模型
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_DEFAULT_HUMAN_FACE_DETECT_MODEL=0
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_HUMAN_FACE_DETECT_MODEL_LOCATION=0

# ===== ESP-DL 必要配置 =====
# 注：不启用 SPIRAM_RODATA — 模型 const 数据放 Flash cache，
#     避免 USB DMA 总线冲突导致 PSRAM 数据损坏

# 主栈增大，给模型加载用
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ===== USB-OTG 主机配置 (UVC 摄像头) =====
# PHY 运行时自动切换，板载 USB-Serial-JTAG 会失效
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=8192
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
#CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR=n

# ===== 任务 WDT 配置 =====
# uvc_frame 任务长时间占用 CPU1 做人脸检测，关掉 IDLE1 的 WDT 检查
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# 推理 3.6s 期间 USB-UVC 任务不会释放 CPU0，也关掉 IDLE0
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
# 加大 WDT 超时（推理可能 >5s）
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ===== 启用 UART0 控制台（UART0 已从 VGPS 释放，用于 PC 调试）=====
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ===== LVGL 大号字体（待机页标题/时间用）=====
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y   # 待机页大时钟 HH:MM:SS (2026-08-04)

# ===== WiFi 省内存配置 (2026-08-02) =====
# USB UVC 需要 5x8KB=40KB 内部 DMA buffer。WiFi 默认占 ~100KB 内部堆，
# 会导致 USB transfer 分配失败 (ESP_ERR_NO_MEM)。
# 注意：CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP 会导致 WiFi 初始化时破坏堆
# （0xa5a5a5a5 = FreeRTOS 栈填充，WiFi task 溢出覆盖堆），已禁用。
# 改为缩减 WiFi buffer 数 + 关闭用不到的 WiFi 特性来省内存。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
# 关闭用不到的 WiFi 特性（本项目只连 WPA2 家用路由器 + ESP-NOW，不需要这些）
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0
